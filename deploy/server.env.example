# Copy to /srv/shop/deploy.env ON THE SERVER. This is trusted shell syntax.
# Match the running installation; do not guess project/volume names.
SHOP_COMPOSE_PROJECT=shop
SHOP_ENV_FILE=/srv/shop/backend/.env
SHOP_DB_VOLUME=shop_shop_postgres
SHOP_UPLOAD_VOLUME=shop_shop_uploads
# Use 0.0.0.0 only if users currently access server-IP:3000 directly.
SHOP_FRONTEND_BIND=127.0.0.1
