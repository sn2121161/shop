# Generate a different Fernet-compatible value for each deployment.
PAYMENT_ENCRYPTION_KEY=replace-with-a-32-byte-url-safe-base64-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
ADMIN_BOOTSTRAP_PASSWORD=change-this-before-first-production-start
# Public browser URL used in password-reset links. Supports HTTP or HTTPS.
FRONTEND_URL=http://localhost:3000
# Configure an SMTP provider to enable actual password-reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ORDER_CHAT_ID=
# Kdniao tracking: use the exact product enabled for your account.
# Keep these on the backend only. 1002 = instant query; 8002 = express query.
KDNIAO_EBUSINESS_ID=
KDNIAO_API_KEY=
KDNIAO_REQUEST_TYPE=8002

# 本地默认留空，使用上面的 8002 手动查询。
# 公网服务器开通订阅后填 1008 标准物流跟踪 / 8008 增值在途监控。
# 登记单号和接收回调必须连接同一数据库，不能在本地登记却回调另一套服务器。
# 此 URL 还必须在快递鸟控制台登记为推送地址；Callback 参数不是推送 URL。
KDNIAO_SUBSCRIBE_REQUEST_TYPE=
KDNIAO_CALLBACK_URL=
