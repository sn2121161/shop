# Generate a different Fernet-compatible value for each deployment.
PAYMENT_ENCRYPTION_KEY=replace-with-a-32-byte-url-safe-base64-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
ADMIN_BOOTSTRAP_PASSWORD=change-this-before-first-production-start
# Public browser URL used in password-reset links. Supports HTTP or HTTPS.
FRONTEND_URL=http://localhost:3000
# Configure an SMTP provider to enable actual password-reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ORDER_CHAT_ID=
# Kdniao free tracking: apply for the free service before using your credentials.
# Keep these on the backend only. Free-plan coverage: YTO / STO / JTSD / HTKY.
KDNIAO_EBUSINESS_ID=
KDNIAO_API_KEY=
